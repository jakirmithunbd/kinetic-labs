{%- comment -%}
  Size picker. Each size shows its own price and price per serving, which is
  the whole point — a 2kg tub looks more expensive until you see the per-serve
  figure next to the 1kg.
{%- endcomment -%}

{%- liquid
  assign target_name = block.settings.option_name | default: 'Size' | downcase | strip
  assign matched = nil
  for option in product.options_with_values
    assign this_name = option.name | downcase | strip
    if this_name == target_name
      assign matched = option
      break
    endif
  endfor
-%}

{%- if matched -%}
  <div class="product-block product-block--size" {{ block.shopify_attributes }}>
    {% render 'option-picker',
      product: product,
      option: matched,
      style: 'card',
      show_per_serving: block.settings.show_price_per_serving,
      section_id: section.id
    %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_info.block_size",
  "settings": [
    {
      "type": "text",
      "id": "option_name",
      "label": "t:sections.product_info.option_name",
      "info": "t:sections.product_info.option_name_info",
      "default": "Size"
    },
    {
      "type": "checkbox",
      "id": "show_price_per_serving",
      "label": "t:sections.product_info.show_price_per_serving",
      "default": true
    }
  ]
}
{% endschema %}
