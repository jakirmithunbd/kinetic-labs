{%- comment -%}
  Product JSON-LD, including AggregateRating and Review when a review app has
  written to the standard reviews.* metafields.

  Everything here is generated from the same objects the page renders, so the
  markup and the page can't disagree.
{%- endcomment -%}

{%- if settings.enable_structured_data and product != blank -%}
  {%- liquid
    assign rating = product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value
    assign currency = cart.currency.iso_code
  -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ shop.url | append: product.url | json }},
      "description": {{ product.description | strip_html | truncate: 500 | json }},
      {% if product.featured_media %}
        "image": [
          {%- for media in product.media limit: 5 -%}
            {%- if media.media_type == 'image' -%}
              {{ media | image_url: width: 1200 | prepend: "https:" | json }}
              {%- unless forloop.last %},{% endunless -%}
            {%- endif -%}
          {%- endfor -%}
        ],
      {% endif %}
      {% if product.vendor != blank %}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
      {% endif %}
      {% if product.selected_or_first_available_variant.sku != blank %}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {% endif %}
      {%- if rating != blank and rating.rating > 0 and rating_count > 0 -%}
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ rating.rating | json }},
          "bestRating": {{ rating.scale_max | default: 5 | json }},
          "worstRating": {{ rating.scale_min | default: 1 | json }},
          "ratingCount": {{ rating_count | json }}
        },
      {%- endif -%}
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "url": {{ shop.url | append: variant.url | json }},
            "priceCurrency": {{ currency | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            {% if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
            "name": {{ variant.title | json }},
            "seller": {
              "@type": "Organization",
              "name": {{ shop.name | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
