{%- comment -%}
  Variant payload for the client-side picker.

  Money strings are formatted by Liquid rather than in JavaScript, so currency
  formatting, Shopify Markets presentment currencies and B2B catalogue pricing
  are all already correct by the time the browser sees them.

  Accepts: product {Product}
{%- endcomment -%}

{%- liquid
  assign product_servings = product.metafields.custom.servings_per_container.value
-%}
{
  "handle": {{ product.handle | json }},
  "url": {{ product.url | json }},
  "optionNames": [
    {%- for option in product.options_with_values -%}
      {{ option.name | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "lowStockThreshold": {{ settings.low_stock_threshold | default: 0 }},
  "variants": [
    {%- for variant in product.variants -%}
      {%- liquid
        assign servings = variant.metafields.custom.servings_per_container.value | default: product_servings
        assign per_serving = nil
        if servings != blank and servings > 0
          assign per_cents = variant.price | times: 1.0 | divided_by: servings | round
          assign per_money = per_cents | money
          assign per_serving = 'products.product.price_per_serving' | t: price: per_money
        endif
      -%}
      {
        "id": {{ variant.id }},
        "title": {{ variant.title | json }},
        "available": {{ variant.available | json }},
        "options": {{ variant.options | json }},
        "sku": {{ variant.sku | json }},
        "price": {{ variant.price | money | strip_html | json }},
        "priceRaw": {{ variant.price }},
        "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
        "perServing": {% if per_serving %}{{ per_serving | json }}{% else %}null{% endif %},
        "featuredMediaId": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %},
        "inventoryManagement": {{ variant.inventory_management | json }},
        "inventoryPolicy": {{ variant.inventory_policy | json }},
        "inventoryQuantity": {{ variant.inventory_quantity | default: 0 }},
        "incoming": {{ variant.incoming | default: false | json }},
        "quantityRule": {
          "min": {{ variant.quantity_rule.min | default: 1 }},
          "max": {% if variant.quantity_rule.max %}{{ variant.quantity_rule.max }}{% else %}null{% endif %},
          "increment": {{ variant.quantity_rule.increment | default: 1 }}
        },
        "sellingPlanAllocations": {
          {%- for allocation in variant.selling_plan_allocations -%}
            {{ allocation.selling_plan.id | json }}: {
              "price": {{ allocation.price | money | strip_html | json }},
              "compareAtPrice": {% if allocation.compare_at_price and allocation.compare_at_price > allocation.price %}{{ allocation.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
              "saving": {% if allocation.compare_at_price and allocation.compare_at_price > allocation.price %}{%- assign saving = allocation.compare_at_price | minus: allocation.price -%}{{ saving | money | strip_html | json }}{% else %}null{% endif %},
              "name": {{ allocation.selling_plan.name | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
