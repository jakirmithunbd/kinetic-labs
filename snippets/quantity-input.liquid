{%- comment -%}
  Quantity stepper. Honours B2B quantity rules — minimum, maximum and
  increment — so a company location that must buy in cases of 6 gets a
  stepper that actually steps in sixes.

  Accepts:
    variant   {Variant} optional, for quantity rules and inventory ceiling
    value     {Number}  default 1
    name      {String}  input name, default "quantity"
    id        {String}  required, unique
    line      {Number}  cart line index, for cart contexts
    label     {String}  accessible label
{%- endcomment -%}

{%- liquid
  assign rules = variant.quantity_rule
  assign min = rules.min | default: 1
  assign step = rules.increment | default: 1
  assign start = value | default: min

  assign max = nil
  if rules.max != blank
    assign max = rules.max
  endif
  if variant and variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
    if max == nil or variant.inventory_quantity < max
      assign max = variant.inventory_quantity
    endif
  endif

  assign input_name = name | default: 'quantity'
  assign input_id = id | default: 'Quantity'
-%}

<kl-quantity class="quantity">
  <button
    type="button"
    class="quantity__button"
    data-step="-1"
    aria-label="{{ 'products.product.decrease_quantity' | t }}"
  >
    {% render 'icon', name: 'minus', size: 16 %}
  </button>

  <label class="visually-hidden" for="{{ input_id }}">
    {{- label | default: 'products.product.quantity' | t -}}
  </label>
  <input
    id="{{ input_id }}"
    class="quantity__input"
    type="number"
    name="{{ input_name }}"
    value="{{ start }}"
    min="{{ min }}"
    step="{{ step }}"
    {% if max %}max="{{ max }}"{% endif %}
    {% if line %}data-cart-quantity data-line="{{ line }}"{% endif %}
    inputmode="numeric"
    autocomplete="off"
  >

  <button
    type="button"
    class="quantity__button"
    data-step="1"
    aria-label="{{ 'products.product.increase_quantity' | t }}"
  >
    {% render 'icon', name: 'plus', size: 16 %}
  </button>
</kl-quantity>

{%- if rules and rules.increment > 1 -%}
  <p class="quantity__rule label-micro">
    {{- 'products.product.quantity' | t }}: {{ rules.increment }}+
  </p>
{%- endif -%}
