{%- comment -%}
  Address form fields, shared by the "add" and "edit" forms.

  Accepts:
    form   {Form}   the customer_address form object
    prefix {String} unique id prefix
{%- endcomment -%}

<div class="contact-form__grid">
  <div class="field">
    <label class="field__label" for="AddressFirstName-{{ prefix }}">
      {{- 'customer.addresses.first_name' | t -}}
    </label>
    <input
      id="AddressFirstName-{{ prefix }}"
      class="field__input"
      type="text"
      name="address[first_name]"
      value="{{ form.first_name }}"
      autocomplete="given-name"
    >
  </div>

  <div class="field">
    <label class="field__label" for="AddressLastName-{{ prefix }}">
      {{- 'customer.addresses.last_name' | t -}}
    </label>
    <input
      id="AddressLastName-{{ prefix }}"
      class="field__input"
      type="text"
      name="address[last_name]"
      value="{{ form.last_name }}"
      autocomplete="family-name"
    >
  </div>

  <div class="field field--full">
    <label class="field__label" for="AddressCompany-{{ prefix }}">
      {{- 'customer.addresses.company' | t -}}
    </label>
    <input
      id="AddressCompany-{{ prefix }}"
      class="field__input"
      type="text"
      name="address[company]"
      value="{{ form.company }}"
      autocomplete="organization"
    >
  </div>

  <div class="field field--full">
    <label class="field__label" for="AddressLine1-{{ prefix }}">
      {{- 'customer.addresses.address1' | t -}}
    </label>
    <input
      id="AddressLine1-{{ prefix }}"
      class="field__input"
      type="text"
      name="address[address1]"
      value="{{ form.address1 }}"
      autocomplete="address-line1"
    >
  </div>

  <div class="field field--full">
    <label class="field__label" for="AddressLine2-{{ prefix }}">
      {{- 'customer.addresses.address2' | t -}}
    </label>
    <input
      id="AddressLine2-{{ prefix }}"
      class="field__input"
      type="text"
      name="address[address2]"
      value="{{ form.address2 }}"
      autocomplete="address-line2"
    >
  </div>

  <div class="field">
    <label class="field__label" for="AddressCity-{{ prefix }}">
      {{- 'customer.addresses.city' | t -}}
    </label>
    <input
      id="AddressCity-{{ prefix }}"
      class="field__input"
      type="text"
      name="address[city]"
      value="{{ form.city }}"
      autocomplete="address-level2"
    >
  </div>

  <div class="field">
    <label class="field__label" for="AddressZip-{{ prefix }}">
      {{- 'customer.addresses.zip' | t -}}
    </label>
    <input
      id="AddressZip-{{ prefix }}"
      class="field__input"
      type="text"
      name="address[zip]"
      value="{{ form.zip }}"
      autocapitalize="characters"
      autocomplete="postal-code"
    >
  </div>

  <div class="field">
    <label class="field__label" for="AddressCountry-{{ prefix }}">
      {{- 'customer.addresses.country' | t -}}
    </label>
    <select
      id="AddressCountry-{{ prefix }}"
      class="field__select"
      name="address[country]"
      autocomplete="country"
      data-address-country-select
      data-province-id="AddressProvince-{{ prefix }}"
      data-province-container="AddressProvinceContainer-{{ prefix }}"
      data-default="{{ form.country }}"
    >
      {{ country_option_tags }}
    </select>
  </div>

  <div class="field" id="AddressProvinceContainer-{{ prefix }}">
    <label class="field__label" for="AddressProvince-{{ prefix }}">
      {{- 'customer.addresses.province' | t -}}
    </label>
    <select
      id="AddressProvince-{{ prefix }}"
      class="field__select"
      name="address[province]"
      autocomplete="address-level1"
      data-default="{{ form.province }}"
    ></select>
  </div>

  <div class="field field--full">
    <label class="field__label" for="AddressPhone-{{ prefix }}">
      {{- 'customer.addresses.phone' | t -}}
    </label>
    <input
      id="AddressPhone-{{ prefix }}"
      class="field__input"
      type="tel"
      name="address[phone]"
      value="{{ form.phone }}"
      autocomplete="tel"
    >
  </div>

  <div class="field field--full">
    <label class="facets__label" for="AddressDefault-{{ prefix }}">
      {{ form.set_as_default_checkbox }}
      <span>{{ 'customer.addresses.set_default' | t }}</span>
    </label>
  </div>
</div>
