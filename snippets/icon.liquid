{%- comment -%}
  Icon set. Inline SVG so icons inherit currentColor and cost no extra request.

  Accepts:
    name  {String} icon key
    size  {Number} px, default 20
    class {String} extra classes

  Usage: {% render 'icon', name: 'cart', size: 22 %}
{%- endcomment -%}

{%- liquid
  assign icon_size = size | default: 20
  assign icon_class = class | default: ''
-%}

{%- capture svg_attrs -%}
  width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
  class="icon icon--{{ name }} {{ icon_class }}" aria-hidden="true" focusable="false"
{%- endcapture -%}

{%- case name -%}
  {%- when 'search' -%}
    <svg {{ svg_attrs }}><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  {%- when 'account' -%}
    <svg {{ svg_attrs }}><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
  {%- when 'cart' -%}
    <svg {{ svg_attrs }}><path d="M4 6h16l-1.4 11.2a2 2 0 0 1-2 1.8H7.4a2 2 0 0 1-2-1.8L4 6Z"/><path d="M9 6V4.5a3 3 0 0 1 6 0V6"/></svg>
  {%- when 'menu' -%}
    <svg {{ svg_attrs }}><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'close' -%}
    <svg {{ svg_attrs }}><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'chevron-down' -%}
    <svg {{ svg_attrs }}><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'chevron-up' -%}
    <svg {{ svg_attrs }}><path d="m6 15 6-6 6 6"/></svg>
  {%- when 'chevron-left' -%}
    <svg {{ svg_attrs }}><path d="m15 6-6 6 6 6"/></svg>
  {%- when 'chevron-right' -%}
    <svg {{ svg_attrs }}><path d="m9 6 6 6-6 6"/></svg>
  {%- when 'arrow-right' -%}
    <svg {{ svg_attrs }}><path d="M4 12h16M14 6l6 6-6 6"/></svg>
  {%- when 'arrow-left' -%}
    <svg {{ svg_attrs }}><path d="M20 12H4M10 6l-6 6 6 6"/></svg>
  {%- when 'minus' -%}
    <svg {{ svg_attrs }}><path d="M5 12h14"/></svg>
  {%- when 'plus' -%}
    <svg {{ svg_attrs }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'check' -%}
    <svg {{ svg_attrs }}><path d="m4 12.5 5 5L20 6.5"/></svg>
  {%- when 'star' -%}
    <svg {{ svg_attrs }} fill="currentColor" stroke="none"><path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.4-5.8-3-5.8 3 1.1-6.4L2.6 9.4l6.5-.9L12 2.6Z"/></svg>
  {%- when 'star-outline' -%}
    <svg {{ svg_attrs }}><path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.4-5.8-3-5.8 3 1.1-6.4L2.6 9.4l6.5-.9L12 2.6Z"/></svg>
  {%- when 'shield' -%}
    <svg {{ svg_attrs }}><path d="M12 3 5 6v6c0 4.4 3 7.7 7 9 4-1.3 7-4.6 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
  {%- when 'truck' -%}
    <svg {{ svg_attrs }}><path d="M2 7h11v9H2zM13 10h4l3 3v3h-7z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="16.5" cy="18" r="1.8"/></svg>
  {%- when 'refresh' -%}
    <svg {{ svg_attrs }}><path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 4v4.5h-4.5"/></svg>
  {%- when 'leaf' -%}
    <svg {{ svg_attrs }}><path d="M20 4c0 9-5.5 13-11 13a5 5 0 0 1 0-10c4 0 6-1 11-3Z"/><path d="M4 20c3-5 6-8 10-10"/></svg>
  {%- when 'flask' -%}
    <svg {{ svg_attrs }}><path d="M10 3v6L4.6 18A2 2 0 0 0 6.4 21h11.2a2 2 0 0 0 1.8-3L14 9V3"/><path d="M9 3h6M7.5 15h9"/></svg>
  {%- when 'filter' -%}
    <svg {{ svg_attrs }}><path d="M3 6h18M6 12h12M10 18h4"/></svg>
  {%- when 'share' -%}
    <svg {{ svg_attrs }}><path d="M12 3v13M8 7l4-4 4 4"/><path d="M5 14v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5"/></svg>
  {%- when 'play' -%}
    <svg {{ svg_attrs }} fill="currentColor" stroke="none"><path d="M8 5.5v13l11-6.5-11-6.5Z"/></svg>
  {%- when 'zoom' -%}
    <svg {{ svg_attrs }}><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8.5v5M8.5 11h5"/></svg>
  {%- when 'grid' -%}
    <svg {{ svg_attrs }}><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg>
  {%- when 'globe' -%}
    <svg {{ svg_attrs }}><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18-2.5-2.7-2.5-15.3 0-18Z"/></svg>
  {%- when 'instagram' -%}
    <svg {{ svg_attrs }}><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg {{ svg_attrs }} fill="currentColor" stroke="none"><path d="M16 3h-2.7v12.2a2.6 2.6 0 1 1-2-2.5V10a5.6 5.6 0 1 0 4.7 5.5V9.1A6.6 6.6 0 0 0 20 10.4V7.6A3.9 3.9 0 0 1 16 3Z"/></svg>
  {%- when 'youtube' -%}
    <svg {{ svg_attrs }}><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10.5 9.5 5 2.5-5 2.5z" fill="currentColor" stroke="none"/></svg>
  {%- when 'facebook' -%}
    <svg {{ svg_attrs }} fill="currentColor" stroke="none"><path d="M14 8.5V7c0-.7.3-1 1-1h1.8V3H14c-2.4 0-3.8 1.4-3.8 3.8v1.7H8V12h2.2v9H14v-9h2.5l.4-3.5H14Z"/></svg>
  {%- when 'x' -%}
    <svg {{ svg_attrs }}><path d="m4 4 16 16M20 4 4 20"/></svg>
  {%- when 'strava' -%}
    <svg {{ svg_attrs }} fill="currentColor" stroke="none"><path d="M10.3 2 4.5 13.4h3.4l2.4-4.8 2.4 4.8h3.4L10.3 2Z"/><path d="m16.1 13.4-1.7 3.3-1.7-3.3h-2.6L14.4 22l4.3-8.6h-2.6Z"/></svg>
  {%- when 'error' -%}
    <svg {{ svg_attrs }}><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5M12 16h.01"/></svg>
  {%- else -%}
    {%- comment -%} Unknown icon key — render nothing rather than a broken box. {%- endcomment -%}
{%- endcase -%}
