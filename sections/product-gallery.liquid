{{ 'component-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign media_list = product.media
  assign featured = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign thumbs = section.settings.thumbnails
  assign group = section.settings.group_by_variant
-%}

{%- if media_list.size > 0 -%}
  <kl-product-gallery
    class="product-gallery product-gallery--thumbs-{{ thumbs }}{% if section.settings.sticky %} product-gallery--sticky{% endif %}"
    data-group-by-variant="{{ group }}"
    data-zoom="{{ section.settings.enable_zoom }}"
  >
    <div
      class="product-gallery__viewport"
      role="region"
      aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
      data-gallery-viewport
    >
      {%- for media in media_list -%}
        {%- liquid
          assign is_active = false
          if media.id == featured.id
            assign is_active = true
          endif

          assign variant_ids = ''
          for variant in product.variants
            if variant.featured_media.id == media.id
              assign variant_ids = variant_ids | append: variant.id | append: ' '
            endif
          endfor
        -%}

        <div
          class="product-gallery__slide{% if is_active %} is-active{% endif %}"
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
          {% if variant_ids != blank %}data-variant-ids="{{ variant_ids | strip }}"{% endif %}
          {% unless is_active %}data-inactive{% endunless %}
        >
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <div class="product-gallery__media media media--{{ section.settings.image_ratio }}">
                <img
                  src="{{ media | image_url: width: 1200 }}"
                  srcset="
                    {{ media | image_url: width: 400 }} 400w,
                    {{ media | image_url: width: 600 }} 600w,
                    {{ media | image_url: width: 900 }} 900w,
                    {{ media | image_url: width: 1200 }} 1200w,
                    {{ media | image_url: width: 1600 }} 1600w
                  "
                  sizes="(min-width: 990px) 50vw, 100vw"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                  data-zoom-src="{{ media | image_url: width: 2400 }}"
                >
              </div>

            {%- when 'video' -%}
              <div class="product-gallery__media media media--{{ section.settings.image_ratio }}">
                {{
                  media
                  | video_tag:
                    image_size: '1200x',
                    controls: true,
                    preload: 'metadata',
                    class: 'product-gallery__video'
                }}
              </div>

            {%- when 'external_video' -%}
              <div class="product-gallery__media media media--wide">
                {{ media | external_video_tag: loading: 'lazy', class: 'product-gallery__video' }}
              </div>

            {%- when 'model' -%}
              <div class="product-gallery__media media media--{{ section.settings.image_ratio }}">
                {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
              </div>

            {%- else -%}
              <div class="product-gallery__media media media--{{ section.settings.image_ratio }}">
                {{ media | media_tag: image_size: '1200x' }}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if thumbs != 'hidden' and media_list.size > 1 -%}
      <div class="product-gallery__thumbs" role="group" aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
        {%- for media in media_list -%}
          {%- liquid
            assign is_active = false
            if media.id == featured.id
              assign is_active = true
            endif
          -%}
          <button
            type="button"
            class="product-gallery__thumb{% if is_active %} is-active{% endif %}"
            data-gallery-thumb
            data-media-id="{{ media.id }}"
            aria-current="{% if is_active %}true{% else %}false{% endif %}"
            aria-label="{{ 'products.product.media.thumbnail_of' | t: index: forloop.index, total: media_list.size }}"
          >
            <img
              src="{{ media.preview_image | image_url: width: 160 }}"
              srcset="{{ media.preview_image | image_url: width: 80 }} 80w, {{ media.preview_image | image_url: width: 160 }} 160w"
              sizes="72px"
              alt=""
              width="72"
              height="72"
              loading="lazy"
            >
            {%- if media.media_type != 'image' -%}
              <span class="product-gallery__thumb-badge" aria-hidden="true">
                {% render 'icon', name: 'play', size: 12 %}
              </span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </kl-product-gallery>

  <script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>
{%- else -%}
  <div class="product-gallery">
    <div class="media media--square">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_gallery.name",
  "tag": "section",
  "class": "product-gallery-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:sections.product_gallery.sticky",
      "default": true
    },
    {
      "type": "select",
      "id": "thumbnails",
      "label": "t:sections.product_gallery.thumbnails",
      "options": [
        { "value": "below", "label": "t:sections.product_gallery.thumbs_below" },
        { "value": "left", "label": "t:sections.product_gallery.thumbs_left" },
        { "value": "hidden", "label": "t:sections.product_gallery.thumbs_hidden" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:shared.image_ratio",
      "options": [
        { "value": "square", "label": "t:shared.ratio_square" },
        { "value": "portrait", "label": "t:shared.ratio_portrait" },
        { "value": "landscape", "label": "t:shared.ratio_landscape" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "t:sections.product_gallery.enable_zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "group_by_variant",
      "label": "t:sections.product_gallery.group_by_variant",
      "info": "t:sections.product_gallery.group_by_variant_info",
      "default": true
    }
  ]
}
{% endschema %}
