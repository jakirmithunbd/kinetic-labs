{{ 'component-content.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width">
    <div class="error-page">
      <p class="error-page__code data" aria-hidden="true">404</p>
      <h1 class="h2">{{ 'templates.404.title' | t }}</h1>
      <p class="text-sm text-muted">{{ 'templates.404.subtext' | t }}</p>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <label class="visually-hidden" for="Search404">{{ 'general.search.search' | t }}</label>
        <div class="search-page__field">
          {% render 'icon', name: 'search', size: 18 %}
          <input
            id="Search404"
            class="search-page__input"
            type="search"
            name="q"
            placeholder="{{ 'general.search.placeholder' | t }}"
          >
          <button type="submit" class="button button--small">{{ 'general.search.submit' | t }}</button>
        </div>
      </form>

      <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">
        {{- 'templates.404.action' | t -}}
      </a>
    </div>

    {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
      <div class="error-page__suggestions">
        {% render 'section-header',
          heading: section.settings.heading,
          align: 'center'
        %}
        <ul class="product-grid list-unstyled" style="--cols-mobile: 2; --cols-desktop: 4;">
          {%- for product in section.settings.collection.products limit: 4 -%}
            <li>{% render 'product-card', card_product: product, index: forloop.index0 %}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "main-404-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "collection", "id": "collection", "label": "t:shared.collection" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "Popular right now"
    },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
