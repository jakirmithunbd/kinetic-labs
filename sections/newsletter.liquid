{{ 'component-home.css' | asset_url | stylesheet_tag }}

<div
  class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width page-width--narrow newsletter-section text-{{ section.settings.alignment }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">[&nbsp;{{ section.settings.eyebrow }}&nbsp;]</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="newsletter-section__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- assign newsletter_form_id = 'Newsletter-' | append: section.id -%}
    {%- form 'customer', class: 'newsletter-section__form', id: newsletter_form_id -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
        {{- 'general.newsletter.label' | t -}}
      </label>
      <div class="newsletter-section__field">
        <input
          id="NewsletterEmail-{{ section.id }}"
          class="field__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ 'general.newsletter.placeholder' | t }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}
        >
        <button type="submit" class="button">{{ 'general.newsletter.submit' | t }}</button>
      </div>

      {%- if form.errors -%}
        <span class="field__error" id="NewsletterError-{{ section.id }}" role="alert">
          {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
        </span>
      {%- elsif form.posted_successfully? -%}
        <p class="newsletter-section__success text-caption" role="status">
          {{- 'general.newsletter.success' | t -}}
        </p>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.disclaimer != blank -%}
      <div class="newsletter-section__disclaimer label-micro rte">{{ section.settings.disclaimer }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "newsletter-block-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-surface"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "Lab notes, occasionally"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:shared.text",
      "default": "<p>New research, new batches, and the occasional restock. No daily email.</p>"
    },
    { "type": "richtext", "id": "disclaimer", "label": "t:sections.newsletter.disclaimer" },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:shared.alignment",
      "options": [
        { "value": "left", "label": "t:shared.align_left" },
        { "value": "center", "label": "t:shared.align_center" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": false },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
