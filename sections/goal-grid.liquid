{{ 'component-home.css' | asset_url | stylesheet_tag }}
{{ 'component-collection.css' | asset_url | stylesheet_tag }}

<div
  class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
  id="{{ section.settings.anchor_id | default: section.id }}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    %}

    <ul
      class="goal-grid list-unstyled"
      style="--cols-mobile: {{ section.settings.columns_mobile }}; --cols-desktop: {{ section.settings.columns_desktop }};"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign target = block.settings.collection
          assign title = block.settings.title | default: target.title
          assign link = block.settings.link | default: target.url
          assign image = block.settings.image | default: target.featured_image
        -%}
        <li {{ block.shopify_attributes }}>
          <a
            class="goal-card{% if settings.animate_on_scroll %} reveal{% endif %}"
            href="{{ link | default: '#' }}"
            style="--reveal-delay: {{ forloop.index0 | times: 60 }}ms;"
          >
            <div class="goal-card__media media media--{{ section.settings.image_ratio }}">
              {%- if image != blank -%}
                <img
                  src="{{ image | image_url: width: 800 }}"
                  srcset="
                    {{ image | image_url: width: 400 }} 400w,
                    {{ image | image_url: width: 800 }} 800w
                  "
                  sizes="(min-width: 990px) 20vw, (min-width: 750px) 33vw, 45vw"
                  alt=""
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <h3 class="goal-card__title">{{ title }}</h3>

            {%- if block.settings.text != blank -%}
              <p class="goal-card__text">{{ block.settings.text }}</p>
            {%- endif -%}

            {%- if section.settings.show_count and target != blank -%}
              <span class="goal-card__count label-micro">
                {{- 'sections.collection_grid.showing_count' | t: count: target.all_products_count -}}
              </span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.goal_grid.name",
  "tag": "section",
  "class": "goal-grid-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow", "default": "SHOP BY GOAL" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "What are you training for?"
    },
    { "type": "richtext", "id": "text", "label": "t:shared.text" },
    { "type": "text", "id": "anchor_id", "label": "t:shared.link", "default": "goals" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:shared.image_ratio",
      "options": [
        { "value": "square", "label": "t:shared.ratio_square" },
        { "value": "portrait", "label": "t:shared.ratio_portrait" },
        { "value": "landscape", "label": "t:shared.ratio_landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns_mobile",
      "options": [
        { "value": "1", "label": "t:shared.one_column" },
        { "value": "2", "label": "t:shared.two_columns" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.goal_grid.show_count",
      "default": true
    },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": false },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "t:sections.goal_grid.block_goal",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:shared.collection" },
        { "type": "text", "id": "title", "label": "t:shared.title" },
        { "type": "text", "id": "text", "label": "t:shared.text" },
        { "type": "image_picker", "id": "image", "label": "t:shared.image" },
        { "type": "url", "id": "link", "label": "t:shared.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.goal_grid.name",
      "blocks": [
        {
          "type": "goal",
          "settings": {
            "title": "Muscle & Strength",
            "text": "Creatine, leucine-rich protein, dosed for hypertrophy."
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Endurance",
            "text": "Citrulline, beta-alanine, electrolytes for the long work."
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Recovery",
            "text": "Magnesium, protein, sleep support to come back faster."
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Sleep",
            "text": "Chelated magnesium and theanine — no melatonin hangover."
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Daily Health",
            "text": "Greens, electrolytes, and the fundamentals, daily."
          }
        }
      ]
    }
  ]
}
{% endschema %}
