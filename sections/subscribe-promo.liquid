{{ 'component-home.css' | asset_url | stylesheet_tag }}

<div
  class="section subscribe-promo color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  {%- if section.settings.image != blank -%}
    <div class="subscribe-promo__background" aria-hidden="true">
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        srcset="
          {{ section.settings.image | image_url: width: 900 }} 900w,
          {{ section.settings.image | image_url: width: 1800 }} 1800w
        "
        sizes="100vw"
        alt=""
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="lazy"
      >
      <span
        class="subscribe-promo__overlay"
        style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
      ></span>
    </div>
  {%- endif -%}

  <div class="page-width subscribe-promo__inner">
    <div class="subscribe-promo__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">[&nbsp;{{ section.settings.eyebrow }}&nbsp;]</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="subscribe-promo__body rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="subscribe-promo__aside">
      {%- comment -%}
        The saving is stated in currency, not just a percentage — "$126/yr" is
        a number a customer can act on; "15%" is one they have to work out.
      {%- endcomment -%}
      {%- if section.settings.saving_amount != blank -%}
        <div class="subscribe-promo__saving">
          <p class="label-micro">{{ section.settings.saving_label }}</p>
          <p class="subscribe-promo__amount data">{{ section.settings.saving_amount }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.subscribe_promo.name",
  "tag": "section",
  "class": "subscribe-promo-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-inverse"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow", "default": "SUBSCRIBE & SAVE" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "Save $126 a year on the stack you already take."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:shared.text",
      "default": "<p>15% off every order, delivered on your schedule. Skip, pause, or swap flavours anytime. No lock-in.</p>"
    },
    {
      "type": "text",
      "id": "saving_label",
      "label": "t:sections.subscribe_promo.saving_label",
      "default": "AVERAGE MEMBER SAVING"
    },
    {
      "type": "text",
      "id": "saving_amount",
      "label": "t:sections.subscribe_promo.saving_amount",
      "info": "t:sections.subscribe_promo.saving_amount_info",
      "default": "$126/yr"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:shared.button_label",
      "default": "Start a subscription"
    },
    { "type": "url", "id": "button_link", "label": "t:shared.button_link" },
    { "type": "image_picker", "id": "image", "label": "t:shared.image" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.hero.overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": false },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [{ "name": "t:sections.subscribe_promo.name" }]
}
{% endschema %}
