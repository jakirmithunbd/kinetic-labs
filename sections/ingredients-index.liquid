{{ 'component-content.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Grid of every ingredient metaobject.

  `metaobjects.ingredient.values` returns the whole set, so a merchant
  who adds a new ingredient in the admin sees it here with no theme change.
{%- endcomment -%}

{%- liquid
  assign ingredients = metaobjects.ingredient.values
-%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    %}

    {%- if section.settings.enable_search -%}
      <kl-faq-search class="faq-search" data-target="IngredientList-{{ section.id }}">
        <label class="visually-hidden" for="IngredientSearch-{{ section.id }}">
          {{- 'general.search.search' | t -}}
        </label>
        <div class="faq-search__field">
          {% render 'icon', name: 'search', size: 16 %}
          <input
            id="IngredientSearch-{{ section.id }}"
            type="search"
            class="faq-search__input"
            placeholder="{{ 'sections.ingredients.heading' | t }}"
            autocomplete="off"
          >
        </div>
        <p class="faq-search__empty text-caption text-muted" data-faq-empty hidden>
          {{- 'general.search.no_results_help' | t -}}
        </p>
      </kl-faq-search>
    {%- endif -%}

    {%- if ingredients.size > 0 -%}
      <ul
        class="ingredient-grid list-unstyled"
        id="IngredientList-{{ section.id }}"
        style="--cols-desktop: {{ section.settings.columns_desktop }};"
      >
        {%- for ingredient in ingredients -%}
          <li
            class="ingredient-card{% if settings.animate_on_scroll %} reveal{% endif %}"
            data-faq-item
            style="--reveal-delay: {{ forloop.index0 | times: 40 }}ms;"
          >
            <a class="ingredient-card__link" href="{{ ingredient.system.url }}">
              {%- if ingredient.image.value != blank -%}
                <span class="ingredient-card__media media media--square">
                  <img
                    src="{{ ingredient.image.value | image_url: width: 400 }}"
                    alt=""
                    width="200"
                    height="200"
                    loading="lazy"
                  >
                </span>
              {%- endif -%}

              <span class="ingredient-card__body">
                <span class="ingredient-card__name h4">{{ ingredient.name.value }}</span>

                {%- if section.settings.show_dose and ingredient.clinical_dose.value != blank -%}
                  <span class="ingredient-card__dose dose">
                    [&nbsp;{% render 'format-dose', value: ingredient.clinical_dose.value, unit: ingredient.unit.value %}&nbsp;]
                  </span>
                {%- endif -%}

                {%- if ingredient.mechanism.value != blank -%}
                  <span class="ingredient-card__mechanism">
                    {{- ingredient.mechanism.value | strip_html | truncatewords: 20 -}}
                  </span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="text-caption text-muted">{{ 'sections.ingredients_index.info' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.ingredients_index.name",
  "tag": "section",
  "class": "ingredients-index-section",
  "settings": [
    { "type": "paragraph", "content": "t:sections.ingredients_index.info" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow", "default": "THE GLOSSARY" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "Every active, explained"
    },
    { "type": "richtext", "id": "text", "label": "t:shared.text" },
    {
      "type": "checkbox",
      "id": "show_dose",
      "label": "t:sections.ingredients_index.show_dose",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "t:sections.ingredients_index.enable_search",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [{ "name": "t:sections.ingredients_index.name" }]
}
{% endschema %}
