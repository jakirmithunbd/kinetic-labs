{{ 'component-product.css' | asset_url | stylesheet_tag }}

<div
  class="product-info color-{{ section.settings.color_scheme }}"
  id="ProductInfo-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-handle="{{ product.handle }}"
>
  {%- comment -%}
    Variant state lives in one element that every block can talk to. Blocks
    stay independently reorderable because none of them owns the state — the
    picker publishes changes, the rest subscribe.
  {%- endcomment -%}
  <kl-variant-state
    id="VariantState-{{ section.id }}"
    data-url="{{ product.url }}"
    data-section="{{ section.id }}"
  >
    <script type="application/json" data-variant-data>
      {% render 'variant-json', product: product %}
    </script>
  </kl-variant-state>

  <div class="product-info__blocks">
    {% content_for 'blocks' %}
  </div>
</div>

{% render 'structured-data-product', product: product %}

<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

<script>
  // Recently viewed is written from the product page and read by the
  // recently-viewed section — nothing leaves the visitor's own browser.
  document.addEventListener('DOMContentLoaded', function () {
    window.KL && window.KL.recordProductView && window.KL.recordProductView('{{ product.handle }}');
  });
</script>

{% schema %}
{
  "name": "t:sections.product_info.name",
  "tag": "section",
  "class": "product-info-section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "sticky_mobile",
      "label": "t:sections.product_info.sticky_mobile",
      "default": true
    },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_info.name",
      "blocks": [
        { "type": "breadcrumb" },
        { "type": "product-title" },
        { "type": "product-rating" },
        { "type": "product-positioning" },
        { "type": "flavour-picker" },
        { "type": "size-picker" },
        { "type": "purchase-options" },
        { "type": "buy-buttons" },
        { "type": "trust-row" },
        { "type": "inventory-status" },
        { "type": "share" }
      ]
    }
  ]
}
{% endschema %}
