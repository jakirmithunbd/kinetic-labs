{{ 'component-home.css' | asset_url | stylesheet_tag }}

<div
  class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    %}

    <ul
      class="multicolumn list-unstyled"
      style="--cols-mobile: {{ section.settings.columns_mobile }}; --cols-desktop: {{ section.settings.columns_desktop }};"
    >
      {%- for block in section.blocks -%}
        <li
          class="multicolumn__item text-{{ section.settings.alignment }}{% if settings.animate_on_scroll %} reveal{% endif %}"
          style="--reveal-delay: {{ forloop.index0 | times: 60 }}ms;"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="multicolumn__media media media--{{ section.settings.image_ratio }}">
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 400 }} 400w,
                  {{ block.settings.image | image_url: width: 800 }} 800w
                "
                sizes="(min-width: 750px) 30vw, 80vw"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <div class="multicolumn__icon">
              {% render 'icon', name: block.settings.icon, size: 28 %}
            </div>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="multicolumn__title h4">{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="multicolumn__text rte text-caption">{{ block.settings.text }}</div>
          {%- endif -%}

          {%- if block.settings.link_label != blank -%}
            <a class="link-mono" href="{{ block.settings.link | default: '#' }}">
              {{ block.settings.link_label }}
              <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "tag": "section",
  "class": "multicolumn-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:shared.heading" },
    { "type": "richtext", "id": "text", "label": "t:shared.text" },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns_mobile",
      "options": [
        { "value": "1", "label": "t:shared.one_column" },
        { "value": "2", "label": "t:shared.two_columns" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:shared.image_ratio",
      "options": [
        { "value": "square", "label": "t:shared.ratio_square" },
        { "value": "portrait", "label": "t:shared.ratio_portrait" },
        { "value": "landscape", "label": "t:shared.ratio_landscape" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:shared.alignment",
      "options": [
        { "value": "left", "label": "t:shared.align_left" },
        { "value": "center", "label": "t:shared.align_center" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": false },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.block_column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:shared.image" },
        {
          "type": "select",
          "id": "icon",
          "label": "t:shared.icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shield", "label": "Shield" },
            { "value": "flask", "label": "Flask" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "truck", "label": "Truck" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "check", "label": "Check" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "heading", "label": "t:shared.heading", "default": "Column" },
        { "type": "richtext", "id": "text", "label": "t:shared.text" },
        { "type": "text", "id": "link_label", "label": "t:shared.link_label" },
        { "type": "url", "id": "link", "label": "t:shared.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.name",
      "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }]
    }
  ]
}
{% endschema %}
