{{ 'component-content.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Shopify's native contact form. Used for both the contact page and the
  wholesale enquiry page — the extra wholesale fields are ordinary blocks, so
  a merchant can add or remove questions without a developer.

  Enquiries arrive at the store's customer email address; no third-party form
  service is involved.
{%- endcomment -%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  id="{{ section.settings.anchor_id | default: section.id }}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width page-width--narrow">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    %}

    {%- form 'contact', id: 'ContactForm-' | append: section.id, class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status" role="status">
          {{- section.settings.success_message | default: 'templates.contact.form.post_success' | t -}}
        </p>
      {%- elsif form.errors -%}
        <div class="form-status form-status--error" role="alert" tabindex="-1" autofocus>
          <p>{{ 'templates.contact.form.error_heading' | t }}</p>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {{ form.errors.translated_fields[field] | capitalize }}
                {{ form.errors.messages[field] }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="contact-form__grid">
        <div class="field">
          <label class="field__label" for="ContactName-{{ section.id }}">
            {{- 'sections.contact.name' | t -}}
          </label>
          <input
            id="ContactName-{{ section.id }}"
            class="field__input"
            type="text"
            name="contact[{{ 'sections.contact.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            autocomplete="name"
          >
        </div>

        <div class="field{% if form.errors contains 'email' %} field--error{% endif %}">
          <label class="field__label" for="ContactEmail-{{ section.id }}">
            {{- 'sections.contact.email' | t }} *
          </label>
          <input
            id="ContactEmail-{{ section.id }}"
            class="field__input"
            type="email"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactEmailError-{{ section.id }}"
            {% endif %}
          >
          {%- if form.errors contains 'email' -%}
            <span class="field__error" id="ContactEmailError-{{ section.id }}">
              {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
            </span>
          {%- endif -%}
        </div>

        {%- if section.settings.show_phone -%}
          <div class="field">
            <label class="field__label" for="ContactPhone-{{ section.id }}">
              {{- 'sections.contact.phone' | t -}}
            </label>
            <input
              id="ContactPhone-{{ section.id }}"
              class="field__input"
              type="tel"
              name="contact[{{ 'sections.contact.phone' | t }}]"
              value="{% if form.phone %}{{ form.phone }}{% endif %}"
              autocomplete="tel"
            >
          </div>
        {%- endif -%}

        {%- comment -%} Extra questions, added as blocks. {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- assign field_id = 'ContactCustom-' | append: section.id | append: '-' | append: forloop.index -%}
          <div
            class="field{% if block.settings.full_width %} field--full{% endif %}"
            {{ block.shopify_attributes }}
          >
            <label class="field__label" for="{{ field_id }}">
              {{- block.settings.label }}{% if block.settings.required %} *{% endif -%}
            </label>
            {%- case block.type -%}
              {%- when 'textarea' -%}
                <textarea
                  id="{{ field_id }}"
                  class="field__textarea"
                  name="contact[{{ block.settings.label | escape }}]"
                  {% if block.settings.required %}required{% endif %}
                ></textarea>
              {%- when 'select' -%}
                <select
                  id="{{ field_id }}"
                  class="field__select"
                  name="contact[{{ block.settings.label | escape }}]"
                  {% if block.settings.required %}required{% endif %}
                >
                  {%- assign options = block.settings.options | newline_to_br | split: '<br />' -%}
                  {%- for option in options -%}
                    {%- assign option_value = option | strip_html | strip -%}
                    {%- if option_value != blank -%}
                      <option value="{{ option_value | escape }}">{{ option_value }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              {%- else -%}
                <input
                  id="{{ field_id }}"
                  class="field__input"
                  type="text"
                  name="contact[{{ block.settings.label | escape }}]"
                  {% if block.settings.required %}required{% endif %}
                >
            {%- endcase -%}
          </div>
        {%- endfor -%}

        <div class="field field--full">
          <label class="field__label" for="ContactBody-{{ section.id }}">
            {{- 'sections.contact.message' | t -}}
          </label>
          <textarea
            id="ContactBody-{{ section.id }}"
            class="field__textarea"
            name="contact[body]"
            rows="6"
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>
      </div>

      <button type="submit" class="button">
        {{- section.settings.submit_label | default: 'sections.contact.send' | t -}}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.wholesale_form.name",
  "tag": "section",
  "class": "contact-form-section",
  "settings": [
    { "type": "paragraph", "content": "t:sections.wholesale_form.info" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:shared.heading", "default": "Get in touch" },
    { "type": "richtext", "id": "text", "label": "t:shared.text" },
    { "type": "text", "id": "anchor_id", "label": "t:shared.link" },
    { "type": "text", "id": "submit_label", "label": "t:shared.button_label" },
    { "type": "text", "id": "success_message", "label": "t:shared.text" },
    { "type": "checkbox", "id": "show_phone", "label": "t:sections.contact.phone", "default": false },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "text_field",
      "name": "t:shared.text",
      "settings": [
        { "type": "text", "id": "label", "label": "t:shared.label", "default": "Company" },
        { "type": "checkbox", "id": "required", "label": "t:general.required", "default": false },
        { "type": "checkbox", "id": "full_width", "label": "t:shared.full_width", "default": false }
      ]
    },
    {
      "type": "select",
      "name": "t:shared.label",
      "settings": [
        { "type": "text", "id": "label", "label": "t:shared.label", "default": "Monthly volume" },
        {
          "type": "textarea",
          "id": "options",
          "label": "t:shared.content",
          "default": "Under 50 units\n50–200 units\n200+ units"
        },
        { "type": "checkbox", "id": "required", "label": "t:general.required", "default": false },
        { "type": "checkbox", "id": "full_width", "label": "t:shared.full_width", "default": false }
      ]
    },
    {
      "type": "textarea",
      "name": "t:sections.contact.message",
      "settings": [
        { "type": "text", "id": "label", "label": "t:shared.label" },
        { "type": "checkbox", "id": "required", "label": "t:general.required", "default": false },
        { "type": "checkbox", "id": "full_width", "label": "t:shared.full_width", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.wholesale_form.name" }]
}
{% endschema %}
