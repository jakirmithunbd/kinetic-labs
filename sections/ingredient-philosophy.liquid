{{ 'component-home.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Editorial two-column argument: the copy on one side, a side-by-side label
  comparison on the other.

  The two label cards are built from plain "Name | Amount" lines rather than
  an uploaded image, so the amounts render in the data typeface, stay
  translatable, and can be corrected by the merchant in seconds.
{%- endcomment -%}

{%- liquid
  assign typical_rows = section.settings.typical_rows | newline_to_br | split: '<br />'
  assign our_rows = section.settings.our_rows | newline_to_br | split: '<br />'
-%}

<div
  class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
  id="{{ section.settings.anchor_id | default: section.id }}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width">
    <div class="philosophy philosophy--image-{{ section.settings.layout }}">
      <div class="philosophy__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">[&nbsp;{{ section.settings.eyebrow }}&nbsp;]</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="h2 philosophy__heading">
            {{ section.settings.heading }}
            {%- if section.settings.heading_light != blank -%}
              <span class="h-display--light">{{ section.settings.heading_light }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="philosophy__body rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- assign points = section.blocks | where: 'type', 'point' -%}
        {%- if points.size > 0 -%}
          <ul class="philosophy__points list-unstyled">
            {%- for block in points -%}
              <li class="philosophy__point" {{ block.shopify_attributes }}>
                {% render 'icon', name: 'check', size: 16 %}
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="button button--secondary philosophy__cta" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>

      <div class="philosophy__visual">
        {%- if section.settings.image != blank -%}
          <div class="philosophy__image media media--portrait">
            <img
              src="{{ section.settings.image | image_url: width: 900 }}"
              srcset="
                {{ section.settings.image | image_url: width: 500 }} 500w,
                {{ section.settings.image | image_url: width: 900 }} 900w
              "
              sizes="(min-width: 990px) 45vw, 100vw"
              alt="{{ section.settings.image.alt | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
            >
          </div>
        {%- endif -%}

        {%- if typical_rows.size > 0 or our_rows.size > 0 -%}
          <div class="label-compare">
            {%- comment -%} The bad example {%- endcomment -%}
            <div class="label-card label-card--typical">
              <p class="label-card__kicker label-micro">{{ section.settings.typical_kicker }}</p>
              <p class="label-card__title">{{ section.settings.typical_heading }}</p>
              {%- if section.settings.typical_total != blank -%}
                <p class="label-card__total data">{{ section.settings.typical_total }}</p>
              {%- endif -%}

              <ul class="label-card__rows list-unstyled">
                {%- for row in typical_rows -%}
                  {%- liquid
                    assign parts = row | strip_html | strip | split: '|'
                    assign row_name = parts[0] | strip
                    assign row_amount = parts[1] | strip
                  -%}
                  {%- if row_name != blank -%}
                    <li class="label-card__row">
                      <span>{{ row_name }}</span>
                      <span class="label-card__amount data label-card__amount--hidden">
                        {{- row_amount | default: '*' -}}
                      </span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

              {%- if section.settings.typical_footer != blank -%}
                <p class="label-card__footer label-micro">{{ section.settings.typical_footer }}</p>
              {%- endif -%}
            </div>

            {%- comment -%} Ours {%- endcomment -%}
            <div class="label-card label-card--ours">
              <p class="label-card__kicker label-micro">{{ section.settings.our_kicker }}</p>
              <p class="label-card__title">{{ section.settings.our_heading }}</p>
              {%- if section.settings.our_total != blank -%}
                <p class="label-card__total data label-card__total--data">
                  {{- section.settings.our_total -}}
                </p>
              {%- endif -%}

              <ul class="label-card__rows list-unstyled">
                {%- for row in our_rows -%}
                  {%- liquid
                    assign parts = row | strip_html | strip | split: '|'
                    assign row_name = parts[0] | strip
                    assign row_amount = parts[1] | strip
                  -%}
                  {%- if row_name != blank -%}
                    <li class="label-card__row">
                      <span>{{ row_name }}</span>
                      <span class="label-card__amount dose">{{ row_amount }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

              {%- if section.settings.our_footer != blank -%}
                <p class="label-card__footer label-micro label-card__footer--ours">
                  {{- section.settings.our_footer -}}
                </p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.ingredient_philosophy.name",
  "tag": "section",
  "class": "philosophy-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-surface"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:shared.eyebrow",
      "default": "NO PROPRIETARY BLENDS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "A \"blend\" is a way to hide"
    },
    {
      "type": "text",
      "id": "heading_light",
      "label": "t:shared.subheading",
      "default": "how little of the good stuff is in there."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:shared.text",
      "default": "<p>When a label says \"Energy Matrix 5000mg\" and lists caffeine last, you have no idea if you're getting 100mg or 300mg. We list every active by weight — in milligrams, ranked by dose, not by what looks impressive.</p>"
    },
    { "type": "text", "id": "anchor_id", "label": "t:shared.link", "default": "philosophy" },
    { "type": "text", "id": "button_label", "label": "t:shared.button_label" },
    { "type": "url", "id": "button_link", "label": "t:shared.button_link" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:shared.layout",
      "options": [
        { "value": "left", "label": "t:shared.align_left" },
        { "value": "right", "label": "t:shared.align_right" }
      ],
      "default": "right"
    },
    { "type": "image_picker", "id": "image", "label": "t:shared.image" },
    { "type": "header", "content": "t:sections.ingredient_philosophy.block_label_compare" },
    {
      "type": "text",
      "id": "typical_kicker",
      "label": "t:sections.ingredient_philosophy.typical_heading",
      "default": "A TYPICAL LABEL"
    },
    {
      "type": "text",
      "id": "typical_heading",
      "label": "t:shared.heading",
      "default": "Energy & Focus Blend"
    },
    { "type": "text", "id": "typical_total", "label": "t:shared.text", "default": "5000mg" },
    {
      "type": "textarea",
      "id": "typical_rows",
      "label": "t:sections.ingredient_philosophy.typical_rows",
      "info": "t:sections.ingredient_philosophy.typical_rows_info",
      "default": "Caffeine Anhydrous | *\nBeta-Alanine | *\nL-Citrulline | *\nL-Tyrosine | *"
    },
    {
      "type": "text",
      "id": "typical_footer",
      "label": "t:sections.ingredient_philosophy.footer_label",
      "default": "* DOSE NOT DISCLOSED"
    },
    {
      "type": "text",
      "id": "our_kicker",
      "label": "t:sections.ingredient_philosophy.our_heading",
      "default": "OUR LABEL"
    },
    {
      "type": "text",
      "id": "our_heading",
      "label": "t:shared.heading",
      "default": "Six actives, named"
    },
    { "type": "text", "id": "our_total", "label": "t:shared.text", "default": "8.20g total" },
    {
      "type": "textarea",
      "id": "our_rows",
      "label": "t:sections.ingredient_philosophy.our_rows",
      "info": "t:sections.ingredient_philosophy.our_rows_info",
      "default": "L-Citrulline Malate | 8.00g\nBeta-Alanine | 3.20g\nCaffeine | 200mg\nL-Tyrosine | 1.50g"
    },
    {
      "type": "text",
      "id": "our_footer",
      "label": "t:sections.ingredient_philosophy.footer_label",
      "default": "EVERY MILLIGRAM LISTED"
    },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": true },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "t:sections.ingredient_philosophy.block_point",
      "settings": [{ "type": "text", "id": "text", "label": "t:shared.text" }]
    }
  ],
  "presets": [
    {
      "name": "t:sections.ingredient_philosophy.name",
      "blocks": [
        { "type": "point", "settings": { "text": "Every active listed by name and exact milligram dose" } },
        { "type": "point", "settings": { "text": "No \"matrix\", \"complex\", or \"blend\" filler lines" } },
        { "type": "point", "settings": { "text": "Doses matched to published clinical ranges" } }
      ]
    }
  ]
}
{% endschema %}
