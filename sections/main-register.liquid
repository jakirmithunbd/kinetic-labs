{{ 'component-content.css' | asset_url | stylesheet_tag }}

<div class="section color-{{ section.settings.color_scheme }}" style="{% render 'section-style', st: 64, sb: 96 %}">
  <div class="page-width">
    <div class="auth-layout">
      <h1 class="h3">{{ 'customer.register.title' | t }}</h1>

      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="form-status form-status--error" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input id="RegisterFirstName" class="field__input" type="text" name="customer[first_name]"
            value="{{ form.first_name }}" autocomplete="given-name">
        </div>

        <div class="field">
          <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input id="RegisterLastName" class="field__input" type="text" name="customer[last_name]"
            value="{{ form.last_name }}" autocomplete="family-name">
        </div>

        <div class="field{% if form.errors contains 'email' %} field--error{% endif %}">
          <label class="field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
          <input id="RegisterEmail" class="field__input" type="email" name="customer[email]"
            value="{{ form.email }}" autocomplete="email" autocorrect="off" autocapitalize="off" required
            {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
        </div>

        <div class="field{% if form.errors contains 'password' %} field--error{% endif %}">
          <label class="field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
          <input id="RegisterPassword" class="field__input" type="password" name="customer[password]"
            autocomplete="new-password" required
            {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}>
        </div>

        <button type="submit" class="button">{{ 'customer.register.submit' | t }}</button>

        <div class="auth-layout__links">
          <a class="link-mono" href="{{ routes.account_login_url }}">{{ 'customer.login_page.sign_in' | t }}</a>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:customer.register.title",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.colour_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
