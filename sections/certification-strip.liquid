{{ 'component-home.css' | asset_url | stylesheet_tag }}

<div
  class="cert-strip color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}{% if section.settings.divider_bottom %} section--hairline-bottom{% endif %}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width cert-strip__inner">
    <ul class="cert-strip__list list-unstyled">
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_tooltip = false
          if block.settings.tooltip != blank
            assign has_tooltip = true
          endif
        -%}
        <li class="cert-strip__item" {{ block.shopify_attributes }}>
          {%- capture cert_body -%}
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 200 }}"
                alt="{{ block.settings.image.alt | default: block.settings.text | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                class="cert-strip__logo"
              >
            {%- else -%}
              <span class="cert-strip__dot" aria-hidden="true"></span>
              <span class="cert-strip__text label-micro">{{ block.settings.text }}</span>
            {%- endif -%}
          {%- endcapture -%}

          {%- if block.settings.link != blank -%}
            <a class="cert-strip__link" href="{{ block.settings.link }}"
              {%- if has_tooltip %} title="{{ block.settings.tooltip | escape }}"{% endif %}>
              {{ cert_body }}
            </a>
          {%- elsif has_tooltip -%}
            {%- comment -%}
              A <abbr> gives the tooltip to a mouse and the expansion to a
              screen reader, without inventing a custom widget.
            {%- endcomment -%}
            <abbr class="cert-strip__abbr" title="{{ block.settings.tooltip | escape }}">
              {{ cert_body }}
            </abbr>
          {%- else -%}
            {{ cert_body }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_batch_lookup -%}
      <form
        class="cert-strip__batch"
        action="{{ section.settings.batch_action | default: routes.search_url }}"
        method="get"
        role="search"
      >
        <label class="visually-hidden" for="BatchLookup-{{ section.id }}">
          {{- 'sections.testing.coa_label' | t -}}
        </label>
        <div class="cert-strip__batch-field">
          {% render 'icon', name: 'search', size: 16 %}
          <input
            id="BatchLookup-{{ section.id }}"
            class="cert-strip__batch-input"
            type="search"
            name="q"
            placeholder="{{ section.settings.batch_placeholder | escape }}"
          >
          <button type="submit" class="link-mono">{{ 'sections.testing.coa_submit' | t }}</button>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.certification_strip.name",
  "tag": "section",
  "class": "cert-strip-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_batch_lookup",
      "label": "t:sections.certification_strip.show_batch_lookup",
      "default": false
    },
    {
      "type": "text",
      "id": "batch_placeholder",
      "label": "t:sections.certification_strip.batch_placeholder",
      "default": "Verify your batch #"
    },
    { "type": "url", "id": "batch_action", "label": "t:shared.link" },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": true },
    { "type": "checkbox", "id": "divider_bottom", "label": "t:shared.divider_bottom", "default": true },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "certification",
      "name": "t:sections.certification_strip.block_logo",
      "settings": [
        { "type": "text", "id": "text", "label": "t:shared.text", "default": "Informed Sport" },
        { "type": "image_picker", "id": "image", "label": "t:shared.image" },
        { "type": "text", "id": "tooltip", "label": "t:sections.certification_strip.tooltip" },
        { "type": "url", "id": "link", "label": "t:shared.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.certification_strip.name",
      "blocks": [
        { "type": "certification", "settings": { "text": "Informed Sport" } },
        { "type": "certification", "settings": { "text": "GMP Certified" } },
        { "type": "certification", "settings": { "text": "Third-party tested" } },
        { "type": "certification", "settings": { "text": "Made in Australia" } }
      ]
    }
  ]
}
{% endschema %}
