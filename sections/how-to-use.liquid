{{ 'component-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign how_to_use = product.metafields.custom.how_to_use
  assign has_content = false
  if how_to_use.value != blank or section.settings.timing != blank or section.settings.stacking != blank
    assign has_content = true
  endif
-%}

{%- if has_content -%}
  <div
    class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
    style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
  >
    <div class="page-width">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading
      %}

      <div class="how-to-use">
        {%- if section.settings.timing != blank -%}
          <div class="how-to-use__column">
            <p class="eyebrow eyebrow--muted">[&nbsp;{{ 'products.how_to_use.timing' | t | upcase }}&nbsp;]</p>
            <div class="rte">{{ section.settings.timing }}</div>
          </div>
        {%- endif -%}

        {%- if section.settings.stacking != blank -%}
          <div class="how-to-use__column">
            <p class="eyebrow eyebrow--muted">[&nbsp;{{ 'products.how_to_use.stacking' | t | upcase }}&nbsp;]</p>
            <div class="rte">{{ section.settings.stacking }}</div>
          </div>
        {%- endif -%}

        {%- comment -%}
          The metafield is the merchant's per-product copy; the two settings
          above are the section's own fallbacks for products that don't have
          it filled in yet.
        {%- endcomment -%}
        {%- if how_to_use.value != blank -%}
          <div class="how-to-use__column how-to-use__column--metafield">
            <div class="rte">{{ how_to_use | metafield_tag }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.how_to_use.name",
  "tag": "section",
  "class": "how-to-use-section",
  "settings": [
    { "type": "paragraph", "content": "t:sections.how_to_use.info" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow", "default": "HOW TO USE" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "Timing & stacking"
    },
    { "type": "richtext", "id": "timing", "label": "t:products.how_to_use.timing" },
    { "type": "richtext", "id": "stacking", "label": "t:products.how_to_use.stacking" },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": true },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [{ "name": "t:sections.how_to_use.name" }]
}
{% endschema %}
