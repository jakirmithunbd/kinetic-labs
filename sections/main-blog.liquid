{{ 'component-home.css' | asset_url | stylesheet_tag }}
{{ 'component-content.css' | asset_url | stylesheet_tag }}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {% render 'breadcrumbs' %}

    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">[&nbsp;{{ section.settings.eyebrow }}&nbsp;]</p>
      {%- endif -%}
      <h1 class="h2">{{ blog.title }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="section-header__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if blog.all_tags.size > 0 -%}
      <nav class="blog-tags" aria-label="{{ 'sections.blog.posted_in' | t }}">
        <ul class="list-unstyled blog-tags__list">
          <li>
            <a
              class="facets__pill{% unless current_tags %} is-active{% endunless %}"
              href="{{ blog.url }}"
            >
              {{- 'general.view_all' | t -}}
            </a>
          </li>
          {%- for tag in blog.all_tags -%}
            <li>
              <a
                class="facets__pill{% if current_tags contains tag %} is-active{% endif %}"
                href="{{ blog.url }}/tagged/{{ tag | handleize }}"
              >
                {{- tag -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.posts_per_page -%}
      {%- if blog.articles.size > 0 -%}
        {%- liquid
          assign featured = nil
          if section.settings.show_featured and paginate.current_page == 1 and current_tags == blank
            assign featured = blog.articles.first
          endif
        -%}

        {%- if featured -%}
          <article class="blog-featured">
            {%- if featured.image -%}
              <a class="blog-featured__media media media--landscape" href="{{ featured.url }}" tabindex="-1" aria-hidden="true">
                <img
                  src="{{ featured.image | image_url: width: 1400 }}"
                  srcset="
                    {{ featured.image | image_url: width: 700 }} 700w,
                    {{ featured.image | image_url: width: 1400 }} 1400w
                  "
                  sizes="(min-width: 990px) 60vw, 100vw"
                  alt=""
                  width="{{ featured.image.width }}"
                  height="{{ featured.image.height }}"
                  fetchpriority="high"
                >
              </a>
            {%- endif -%}
            <div class="blog-featured__body">
              <p class="article-card__meta label-micro">
                {%- if featured.tags.first != blank -%}
                  <span class="article-card__category">{{ featured.tags.first }}</span>
                  <span aria-hidden="true">&middot;</span>
                {%- endif -%}
                <time datetime="{{ featured.published_at | date: '%Y-%m-%d' }}">
                  {{- featured.published_at | date: format: 'abbreviated_date' -}}
                </time>
              </p>
              <h2 class="h2">
                <a href="{{ featured.url }}">{{ featured.title }}</a>
              </h2>
              <p class="blog-featured__excerpt text-body-lg">
                {{- featured.excerpt_or_content | strip_html | truncatewords: 40 -}}
              </p>
              <a class="link-mono" href="{{ featured.url }}">
                {{ 'sections.blog.read_article' | t }}
                <span class="arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        {%- endif -%}

        <ul class="article-grid list-unstyled" style="--cols-desktop: {{ section.settings.columns_desktop }};">
          {%- for article in blog.articles -%}
            {%- if featured and forloop.first -%}{%- continue -%}{%- endif -%}
            {% render 'article-card',
              article: article,
              show_image: true,
              show_excerpt: true,
              show_date: true,
              show_category: true,
              index: forloop.index0
            %}
          {%- endfor -%}
        </ul>

        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "tag": "section",
  "class": "main-blog-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow", "default": "LAB NOTES" },
    { "type": "richtext", "id": "text", "label": "t:shared.text" },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "t:sections.main_blog.show_featured",
      "default": true
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:shared.posts_to_show",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
