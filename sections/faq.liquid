{%- comment -%}
  Generic FAQ accordion. Questions come from section blocks, or from an
  faq_entry metaobject list when one is chosen — the FAQ page uses the
  metaobject so the same answers can be reused on product pages.
{%- endcomment -%}

{%- liquid
  assign entries = section.settings.faq_metaobjects.value
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
-%}

<div
  class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %}">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    %}

    {%- if section.settings.searchable -%}
      <kl-faq-search class="faq-search" data-target="FaqList-{{ section.id }}">
        <label class="visually-hidden" for="FaqSearch-{{ section.id }}">
          {{- 'general.search.search' | t -}}
        </label>
        <div class="faq-search__field">
          {% render 'icon', name: 'search', size: 16 %}
          <input
            id="FaqSearch-{{ section.id }}"
            type="search"
            class="faq-search__input"
            placeholder="{{ 'general.search.placeholder' | t }}"
            autocomplete="off"
          >
        </div>
        <p class="faq-search__empty text-caption text-muted" data-faq-empty hidden>
          {{- 'general.search.no_results_help' | t -}}
        </p>
      </kl-faq-search>
    {%- endif -%}

    <div id="FaqList-{{ section.id }}">
      {%- capture block_items -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank -%}
            <details class="accordion__item" data-faq-item {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                <span>{{ block.settings.question }}</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </summary>
              <div class="accordion__panel rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {% render 'faq-accordion',
        entries: entries,
        exclusive: section.settings.exclusive,
        id_prefix: 'Faq',
        extra_items: block_items
      %}
    </div>
  </div>
</div>

{%- if section.settings.structured_data and settings.enable_structured_data -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign printed = 0 -%}
        {%- if entries != blank -%}
          {%- for entry in entries -%}
            {%- if printed > 0 %},{% endif -%}
            {
              "@type": "Question",
              "name": {{ entry.question.value | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ entry.answer.value | strip_html | json }} }
            }
            {%- assign printed = printed | plus: 1 -%}
          {%- endfor -%}
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank -%}
            {%- if printed > 0 %},{% endif -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
            }
            {%- assign printed = printed | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "section",
  "class": "faq-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow", "default": "FAQ" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "Questions, answered"
    },
    { "type": "richtext", "id": "text", "label": "t:shared.text" },
    {
      "type": "metaobject_list",
      "id": "faq_metaobjects",
      "metaobject_type": "faq_entry",
      "label": "t:sections.faq.block_question"
    },
    {
      "type": "checkbox",
      "id": "searchable",
      "label": "t:sections.faq.searchable",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "exclusive",
      "label": "t:sections.faq.exclusive",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "t:sections.faq.structured_data",
      "default": true
    },
    { "type": "checkbox", "id": "narrow", "label": "t:shared.layout", "default": true },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": false },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.block_question",
      "settings": [
        { "type": "text", "id": "question", "label": "t:sections.faq.question" },
        { "type": "richtext", "id": "answer", "label": "t:sections.faq.answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
