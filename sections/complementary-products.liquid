{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Product Recommendations API with complementary intent. The pairings
  themselves are set in the Search & Discovery app, not here.

  The section renders its own markup when Shopify has already resolved
  recommendations, and otherwise fetches itself — that keeps the initial HTML
  small without losing the content for crawlers on the second pass.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.products_to_show
  assign recommendations = recommendations.products
-%}

<kl-recommendations
  class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ section.settings.intent }}"
  data-section-id="{{ section.id }}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
  {% if recommendations.size == 0 %}data-empty{% endif %}
>
  {%- if recommendations.size > 0 -%}
    <div class="page-width">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading
      %}

      <ul
        class="product-grid list-unstyled"
        style="--cols-mobile: 2; --cols-desktop: {{ limit }};"
      >
        {%- for recommendation in recommendations limit: limit -%}
          <li>
            {% render 'product-card', card_product: recommendation, index: forloop.index0 %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</kl-recommendations>

<script src="{{ 'recommendations.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.complementary.name",
  "tag": "section",
  "class": "complementary-section",
  "settings": [
    { "type": "paragraph", "content": "t:sections.complementary.info" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:shared.eyebrow",
      "default": "COMPLETE THE STACK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "Pairs well with"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.complementary.name",
      "options": [
        { "value": "complementary", "label": "Complementary" },
        { "value": "related", "label": "Related" }
      ],
      "default": "complementary"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:shared.products_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": true },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [{ "name": "t:sections.complementary.name" }]
}
{% endschema %}
