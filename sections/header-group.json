{
  "type": "header",
  "name": "Header group",
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "blocks": {
        "message-1": {
          "type": "message",
          "settings": {
            "text": "Free shipping on orders over $99",
            "link": ""
          }
        },
        "message-2": {
          "type": "message",
          "settings": {
            "text": "Third-party tested. Every batch, every time.",
            "link": "/pages/testing"
          }
        }
      },
      "block_order": ["message-1", "message-2"],
      "settings": {
        "color_scheme": "scheme-inverse",
        "rotate": true,
        "interval": 6,
        "dismissible": false,
        "show_localization": false
      }
    },
    "header": {
      "type": "header",
      "blocks": {
        "mega-shop": {
          "type": "mega_menu",
          "settings": {
            "menu_item": "Shop",
            "column_1_title": "By goal",
            "column_2_title": "By format",
            "column_3_title": "Learn"
          }
        }
      },
      "block_order": ["mega-shop"],
      "settings": {
        "color_scheme": "scheme-1",
        "logo_height": 24,
        "menu": "main-menu",
        "menu_layout": "inline",
        "sticky": true,
        "transparent": false,
        "show_search": true,
        "predictive_search": true,
        "show_account": true,
        "show_localization": false
      }
    }
  },
  "order": ["announcement-bar", "header"]
}
