{{ 'component-home.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Testimonial highlights.

  These blocks are editorial placeholders the merchant controls. When a review
  app is installed, add its app block here instead — the app block slot below
  renders live, moderated reviews and this section steps out of the way.
{%- endcomment -%}

<div
  class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
  id="{{ section.settings.anchor_id | default: section.id }}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      link_url: section.settings.link,
      link_label: section.settings.link_label
    %}

    {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
    {%- if review_blocks.size > 0 -%}
      <ul class="reviews list-unstyled" style="--cols-desktop: {{ section.settings.columns_desktop }};">
        {%- for block in review_blocks -%}
          <li
            class="review-card{% if settings.animate_on_scroll %} reveal{% endif %}"
            style="--reveal-delay: {{ forloop.index0 | times: 70 }}ms;"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.rating > 0 -%}
              <div
                class="review-card__stars"
                role="img"
                aria-label="{{ 'accessibility.star_rating' | t: rating: block.settings.rating, scale: 5 }}"
              >
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.rating -%}
                    {% render 'icon', name: 'star', size: 12 %}
                  {%- else -%}
                    {% render 'icon', name: 'star-outline', size: 12 %}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            <blockquote class="review-card__quote">{{ block.settings.quote }}</blockquote>

            <footer class="review-card__meta">
              <cite class="review-card__author">{{ block.settings.author }}</cite>
              {%- if block.settings.product != blank -%}
                <a class="review-card__product label-micro" href="{{ block.settings.product.url }}">
                  {{- block.settings.product.title -}}
                </a>
              {%- elsif block.settings.product_name != blank -%}
                <span class="review-card__product label-micro">{{ block.settings.product_name }}</span>
              {%- endif -%}
              {%- if block.settings.verified -%}
                <span class="badge badge--support review-card__verified">
                  {% render 'icon', name: 'check', size: 10 %}
                  {{ 'general.verified' | t }}
                </span>
              {%- endif -%}
            </footer>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
    {%- if app_blocks.size > 0 -%}
      <div class="reviews__app-slot">
        {%- for block in app_blocks -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.review_highlight.name",
  "tag": "section",
  "class": "review-highlight-section",
  "max_blocks": 9,
  "settings": [
    { "type": "paragraph", "content": "t:sections.review_highlight.app_slot_info" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:shared.eyebrow",
      "default": "VERIFIED REVIEWS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "4.9 from 2,100+ buyers"
    },
    { "type": "text", "id": "link_label", "label": "t:shared.link_label", "default": "READ ALL" },
    { "type": "url", "id": "link", "label": "t:shared.link" },
    { "type": "text", "id": "anchor_id", "label": "t:shared.link" },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": true },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.review_highlight.block_review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "t:sections.review_highlight.quote" },
        { "type": "text", "id": "author", "label": "t:sections.review_highlight.author" },
        { "type": "product", "id": "product", "label": "t:shared.product" },
        { "type": "text", "id": "product_name", "label": "t:shared.title" },
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.review_highlight.rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "t:sections.review_highlight.verified",
          "default": true
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "t:sections.review_highlight.name",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "I've bought four tubs. The scoop actually weighs 5g on my scale, which is more than I can say for the last brand. Unflavoured mixes into anything.",
            "author": "Jemma R.",
            "product_name": "Creatine Monohydrate"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "First pre-workout where I didn't have to guess what was in it. The dose panel sold me — 8g citrulline is 8g citrulline. No tingles theatre.",
            "author": "Daniel K.",
            "product_name": "Pre-Workout"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Took about a week to notice, but I'm falling asleep faster and not waking at 3am. No groggy mornings like with melatonin.",
            "author": "Priya S.",
            "product_name": "Magnesium Sleep"
          }
        }
      ]
    }
  ]
}
{% endschema %}
