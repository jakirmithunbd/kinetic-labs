{{ 'component-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.source == 'all'
    assign collections_to_show = collections
  else
    assign collections_to_show = collections
  endif
-%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    %}

    <ul
      class="collection-list list-unstyled"
      style="--cols-mobile: {{ section.settings.columns_mobile }}; --cols-desktop: {{ section.settings.columns_desktop }};"
    >
      {%- for collection in collections_to_show -%}
        {%- if collection.all_products_count == 0 and section.settings.hide_empty -%}
          {%- continue -%}
        {%- endif -%}
        <li>
          <a
            class="collection-card{% if settings.animate_on_scroll %} reveal{% endif %}"
            href="{{ collection.url }}"
            style="--reveal-delay: {{ forloop.index0 | times: 50 }}ms;"
          >
            <div class="collection-card__media media media--{{ section.settings.image_ratio }}">
              {%- if collection.featured_image -%}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  srcset="
                    {{ collection.featured_image | image_url: width: 400 }} 400w,
                    {{ collection.featured_image | image_url: width: 800 }} 800w
                  "
                  sizes="(min-width: 750px) 30vw, 45vw"
                  alt="{{ collection.featured_image.alt | escape }}"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <h3 class="collection-card__title">{{ collection.title }}</h3>

            {%- if section.settings.show_description and collection.description != blank -%}
              <p class="collection-card__text">
                {{- collection.description | strip_html | truncatewords: 18 -}}
              </p>
            {%- endif -%}

            {%- if section.settings.show_count -%}
              <span class="collection-card__count label-micro">
                {{- 'sections.collection_grid.showing_count' | t: count: collection.all_products_count -}}
              </span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:shared.collection",
  "tag": "section",
  "class": "list-collections-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:shared.heading", "default": "Collections" },
    { "type": "richtext", "id": "text", "label": "t:shared.text" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:shared.image_ratio",
      "options": [
        { "value": "square", "label": "t:shared.ratio_square" },
        { "value": "portrait", "label": "t:shared.ratio_portrait" },
        { "value": "landscape", "label": "t:shared.ratio_landscape" }
      ],
      "default": "landscape"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns_mobile",
      "options": [
        { "value": "1", "label": "t:shared.one_column" },
        { "value": "2", "label": "t:shared.two_columns" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.collection_banner.show_description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.collection_banner.show_product_count",
      "default": true
    },
    { "type": "checkbox", "id": "hide_empty", "label": "t:shared.view_all", "default": true },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [{ "name": "t:shared.collection" }]
}
{% endschema %}
