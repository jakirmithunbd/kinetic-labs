{{ 'component-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_market = localization.market.handle
  assign visible_blocks = 0
-%}

{%- capture bar_content -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign markets = block.settings.markets | strip
      assign show = true
      if markets != blank
        assign show = false
        assign market_list = markets | downcase | split: ','
        for m in market_list
          assign m_handle = m | strip
          if m_handle == current_market
            assign show = true
            break
          endif
        endfor
      endif
    -%}
    {%- if show and block.settings.text != blank -%}
      {%- assign visible_blocks = visible_blocks | plus: 1 -%}
      <div
        class="announcement__message"
        data-announcement-slide
        {% if visible_blocks > 1 %}hidden{% endif %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.link != blank -%}
          <a class="announcement__link" href="{{ block.settings.link }}">
            {{- block.settings.text | escape -}}
          </a>
        {%- else -%}
          <span>{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if visible_blocks > 0 -%}
  <kl-announcement-bar
    class="announcement color-{{ section.settings.color_scheme }}"
    {% if section.settings.rotate and visible_blocks > 1 %}
      data-rotate
      data-interval="{{ section.settings.interval | times: 1000 }}"
    {% endif %}
    {% if section.settings.dismissible %}data-dismissible data-storage-key="kl:announcement:{{ section.id }}"{% endif %}
  >
    <div class="announcement__inner page-width">
      {%- if section.settings.rotate and visible_blocks > 1 -%}
        <button
          type="button"
          class="announcement__nav"
          data-announcement-prev
          aria-label="{{ 'sections.announcements.previous' | t }}"
        >
          {% render 'icon', name: 'chevron-left', size: 14 %}
        </button>
      {%- endif -%}

      <div class="announcement__viewport" aria-live="polite" aria-atomic="true">
        {{ bar_content }}
      </div>

      {%- if section.settings.rotate and visible_blocks > 1 -%}
        <button
          type="button"
          class="announcement__nav"
          data-announcement-next
          aria-label="{{ 'sections.announcements.next' | t }}"
        >
          {% render 'icon', name: 'chevron-right', size: 14 %}
        </button>
      {%- endif -%}

      {%- if section.settings.show_localization -%}
        <div class="announcement__localization">
          {% render 'localization-form', context: 'announcement', compact: true %}
        </div>
      {%- endif -%}

      {%- if section.settings.dismissible -%}
        <button
          type="button"
          class="announcement__dismiss"
          data-announcement-dismiss
          aria-label="{{ 'sections.announcements.dismiss' | t }}"
        >
          {% render 'icon', name: 'close', size: 14 %}
        </button>
      {%- endif -%}
    </div>
  </kl-announcement-bar>

  <script src="{{ 'announcement-bar.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "aside",
  "class": "announcement-section",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-inverse"
    },
    {
      "type": "checkbox",
      "id": "rotate",
      "label": "t:sections.announcement_bar.rotate",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "t:sections.announcement_bar.interval",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "t:sections.announcement_bar.dismissible",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "t:sections.announcement_bar.show_localization",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.block_message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.announcement_bar.block_text",
          "default": "Free shipping on orders over $99"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:shared.link"
        },
        {
          "type": "text",
          "id": "markets",
          "label": "t:sections.announcement_bar.market_visibility",
          "info": "t:sections.announcement_bar.market_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
