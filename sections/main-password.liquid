<div class="section color-{{ section.settings.color_scheme }}" style="{% render 'section-style', st: 96, sb: 96 %}">
  <div class="page-width">
    <div class="error-page">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_width = section.settings.logo_height | times: section.settings.logo.aspect_ratio | round -%}
        <img
          src="{{ section.settings.logo | image_url: width: logo_width, height: section.settings.logo_height }}"
          alt="{{ shop.name | escape }}"
          width="{{ logo_width }}"
          height="{{ section.settings.logo_height }}"
        >
      {%- else -%}
        <p class="h3">{{ shop.name }}</p>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">[&nbsp;{{ section.settings.eyebrow }}&nbsp;]</p>
      {%- endif -%}

      {%- assign default_password_heading = 'templates.password.opens_soon' | t -%}
      <h1 class="h2">{{ section.settings.heading | default: default_password_heading }}</h1>

      {%- if section.settings.text != blank -%}
        <div class="rte text-body-lg">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- comment -%} Newsletter capture while the store is closed. {%- endcomment -%}
      {%- if section.settings.show_newsletter -%}
        {%- form 'customer', class: 'newsletter-section__form', id: 'PasswordNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
          <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter.label' | t }}</label>
          <div class="newsletter-section__field">
            <input
              id="PasswordEmail"
              class="field__input"
              type="email"
              name="contact[email]"
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="button">{{ 'general.newsletter.submit' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="newsletter-section__success text-caption" role="status">
              {{- 'general.newsletter.success' | t -}}
            </p>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}

      <details class="password-login">
        <summary class="link-mono">{{ 'templates.password.login_heading' | t }}</summary>
        <div class="auth-layout">
          {%- form 'storefront_password', class: 'password-login__form' -%}
            <div class="field{% if form.errors %} field--error{% endif %}">
              <label class="field__label" for="StorefrontPassword">
                {{- 'templates.password.login_password' | t -}}
              </label>
              <input
                id="StorefrontPassword"
                class="field__input"
                type="password"
                name="password"
                autocomplete="current-password"
                {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError"{% endif %}
              >
              {%- if form.errors -%}
                <span class="field__error" id="PasswordError" role="alert">
                  {{- 'templates.password.login_error' | t -}}
                </span>
              {%- endif -%}
            </div>
            <button type="submit" class="button">{{ 'templates.password.login_submit' | t }}</button>
          {%- endform -%}
        </div>
      </details>

      {% render 'social-icons' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "image_picker", "id": "logo", "label": "t:sections.header.logo" },
    {
      "type": "range",
      "id": "logo_height",
      "label": "t:sections.header.logo_height",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:shared.heading" },
    { "type": "richtext", "id": "text", "label": "t:shared.text" },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.newsletter.name",
      "default": true
    }
  ]
}
{% endschema %}
