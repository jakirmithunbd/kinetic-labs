{{ 'component-dosage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The signature section on the home page.

  A merchant picks any product; the bars are rendered from that product's
  custom.dose_comparison metafield. Exactly the same dosage-bar component the
  product page uses — the home page and the PDP can never disagree about a
  dose, because they read the same records.
{%- endcomment -%}

{%- liquid
  assign source = section.settings.product
  assign records = source.metafields.custom.dose_comparison.value
-%}

<div
  class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
  id="{{ section.settings.anchor_id | default: section.id }}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    %}

    {%- if records != blank and records.size > 0 -%}
      <div class="dosage-panel">
        {%- for record in records -%}
          {% render 'dosage-bar',
            record: record,
            show_studied: section.settings.show_studied,
            bar_style: section.settings.bar_style,
            index: forloop.index0
          %}
        {%- endfor -%}
      </div>

      {%- if section.settings.footnote != blank -%}
        <p class="dosage-panel__footnote">{{ section.settings.footnote }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="dosage-panel__cta">
          <a
            class="button button--secondary"
            href="{{ section.settings.button_link | default: source.url }}"
          >
            {{- section.settings.button_label -}}
          </a>
        </div>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <p class="text-caption text-muted">
        {{- 'sections.dosage_panel.info' | t -}}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.dosage_panel.name",
  "tag": "section",
  "class": "dosage-panel-section",
  "settings": [
    { "type": "paragraph", "content": "t:sections.dosage_panel.info" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "product", "id": "product", "label": "t:shared.product" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:shared.eyebrow",
      "default": "THE DOSAGE PANEL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "5.00g of creatine. Not a \"blend\"."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:shared.text",
      "default": "<p>Pre-Workout. Six actives, dosed to the literature. Here's our gram-for-gram next to the industry average.</p>"
    },
    { "type": "text", "id": "anchor_id", "label": "t:shared.link", "default": "dosage" },
    {
      "type": "select",
      "id": "bar_style",
      "label": "t:sections.dosage_panel.bar_style",
      "options": [
        { "value": "bars", "label": "t:sections.dosage_panel.style_bars" },
        { "value": "minimal", "label": "t:sections.dosage_panel.style_minimal" }
      ],
      "default": "bars"
    },
    {
      "type": "checkbox",
      "id": "show_studied",
      "label": "t:sections.dosage_panel.show_studied",
      "default": false
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:sections.dosage_panel.footnote",
      "default": "Industry averages from a 2024 audit of 32 best-selling pre-workouts. Clinical dose = minimum effective in published trials."
    },
    { "type": "text", "id": "button_label", "label": "t:shared.button_label" },
    { "type": "url", "id": "button_link", "label": "t:shared.button_link" },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": true },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [{ "name": "t:sections.dosage_panel.name" }]
}
{% endschema %}
