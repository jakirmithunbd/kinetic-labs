{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign target = section.settings.collection
  assign products = target.products
  assign limit = section.settings.products_to_show
  assign carousel = false
  if section.settings.display == 'carousel'
    assign carousel = true
  endif
-%}

<div
  class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
  style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
>
  <div class="page-width">
    {%- liquid
      assign link_url = nil
      assign link_label = nil
      if section.settings.show_view_all and target != blank
        assign link_url = target.url
        assign link_label = 'general.view_all' | t
      endif
    -%}
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      link_url: link_url,
      link_label: link_label
    %}

    {%- if products.size > 0 -%}
      <ul
        class="product-grid{% if carousel %} product-grid--carousel{% endif %} list-unstyled"
        style="--cols-mobile: {{ section.settings.columns_mobile }}; --cols-desktop: {{ section.settings.columns_desktop }};"
      >
        {%- for product in products limit: limit -%}
          <li>
            {% render 'product-card',
              card_product: product,
              index: forloop.index0,
              sizes: '(min-width: 990px) 22vw, (min-width: 750px) 33vw, 45vw'
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      {%- comment -%} Onboarding: show placeholders so the layout is reviewable. {%- endcomment -%}
      <ul
        class="product-grid list-unstyled"
        style="--cols-mobile: {{ section.settings.columns_mobile }}; --cols-desktop: {{ section.settings.columns_desktop }};"
      >
        {%- for i in (1..limit) -%}
          <li>{% render 'product-card' %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "collection", "id": "collection", "label": "t:shared.collection" },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow", "default": "BEST SELLERS" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "The six people come back for"
    },
    { "type": "richtext", "id": "text", "label": "t:shared.text" },
    {
      "type": "select",
      "id": "display",
      "label": "t:sections.featured_collection.display",
      "options": [
        { "value": "grid", "label": "t:sections.featured_collection.display_grid" },
        { "value": "carousel", "label": "t:sections.featured_collection.display_carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:shared.products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns_mobile",
      "options": [
        { "value": "1", "label": "t:shared.one_column" },
        { "value": "2", "label": "t:shared.two_columns" }
      ],
      "default": "2"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "t:shared.view_all", "default": true },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": true },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
