{%- liquid
  assign entries = product.metafields.custom.product_faq.value
-%}

{%- if entries != blank and entries.size > 0 -%}
  <div
    class="section color-{{ section.settings.color_scheme }}{% if section.settings.divider_top %} section--hairline-top{% endif %}"
    style="{% render 'section-style', st: section.settings.padding_top, sb: section.settings.padding_bottom %}"
  >
    <div class="page-width page-width--narrow">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading
      %}

      {% render 'faq-accordion',
        entries: entries,
        exclusive: section.settings.exclusive,
        id_prefix: 'ProductFaq'
      %}
    </div>
  </div>

  {%- if section.settings.structured_data and settings.enable_structured_data -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for entry in entries -%}
            {
              "@type": "Question",
              "name": {{ entry.question.value | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ entry.answer.value | strip_html | json }}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_faq.name",
  "tag": "section",
  "class": "product-faq-section",
  "settings": [
    { "type": "paragraph", "content": "t:sections.product_faq.info" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.colour_scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "t:shared.eyebrow", "default": "FAQ" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading",
      "default": "Questions, answered"
    },
    { "type": "checkbox", "id": "exclusive", "label": "t:sections.faq.exclusive", "default": false },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "t:sections.faq.structured_data",
      "default": true
    },
    { "type": "checkbox", "id": "divider_top", "label": "t:shared.divider_top", "default": true },
    { "type": "header", "content": "t:shared.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [{ "name": "t:sections.product_faq.name" }]
}
{% endschema %}
