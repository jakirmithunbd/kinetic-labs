            "type": "color",
            "id": "support",
            "label": "t:settings.colors.support",
            "default": "#7A8B6F"
          },
          {
            "type": "color",
            "id": "data",
            "label": "t:settings.colors.data",
            "info": "t:settings.colors.data_info",
            "default": "#2B4FD9"
          },
          { "type": "header", "content": "t:settings.colors.buttons" },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings.colors.button",
            "default": "#C4553A"
