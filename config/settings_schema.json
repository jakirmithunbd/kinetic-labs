  {
    "name": "t:settings.typography.name",
    "settings": [
      { "type": "paragraph", "content": "t:settings.typography.self_hosted_info" },
      {
        "type": "checkbox",
        "id": "use_brand_fonts",
        "label": "t:settings.typography.use_brand_fonts",
        "info": "t:settings.typography.use_brand_fonts_info",
        "default": true
      },
      { "type": "header", "content": "t:settings.typography.display_header" },
      {
        "type": "font_picker",
        "id": "font_display",
        "label": "t:settings.typography.display_font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "display_scale",
        "label": "t:settings.typography.display_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "select",
        "id": "display_weight",
        "label": "t:settings.typography.display_weight",
        "options": [
          { "value": "300", "label": "t:settings.typography.weight_light" },
          { "value": "400", "label": "t:settings.typography.weight_regular" },
          { "value": "500", "label": "t:settings.typography.weight_medium" }
        ],
        "default": "400"
      },
      { "type": "header", "content": "t:settings.typography.body_header" },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "t:settings.typography.body_font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "t:settings.typography.body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      { "type": "header", "content": "t:settings.typography.data_header" },
      { "type": "paragraph", "content": "t:settings.typography.data_info" },
      {
        "type": "range",
        "id": "data_tracking",
        "label": "t:settings.typography.data_tracking",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "t:settings.typography.tracking_unit",
        "default": 14
      }
    ]
  },
  {
